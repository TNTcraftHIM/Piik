# Copy to the ignored .env.maintenance.local; never commit real credentials.
# Cloudflare: Zone Read, Cache Rules Read, Transform Rules Read, Cache Purge.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Comma-separated website hostnames, once Silip has a website.
SILIP_WEBSITE_HOSTS=

# Managed Linux Server checks. SSH may use an existing alias from ~/.ssh/config.
SILIP_SSH_TARGET=user@server.example
SILIP_SSH_KEY=
SILIP_SERVER_ORIGIN=https://share.example.com
