{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "jsx": "react-jsx", "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "web/**/*.tsx"]
}
