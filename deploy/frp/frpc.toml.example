# Run beside Piik; inject the same nonempty FRP_TOKEN into frpc and frps.
# See docs/operations/self-hosting.md for the public HTTPS proxy and frps setup.
# This forwards HTTP/WebSocket only; media uses the runtime's ICE paths.
serverAddr = "relay.example.com"
serverPort = 7000
auth.token = "{{ .Envs.FRP_TOKEN }}"
transport.tls.enable = true

[[proxies]]
name = "piik-web"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8787
remotePort = 8787
