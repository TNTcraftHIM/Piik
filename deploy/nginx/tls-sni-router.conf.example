# OPTIONAL TURN/TLS-on-443 topology only. Do not include this file for the
# default deployment. It requires nginx's stream and ssl_preread modules.
#
# Before enabling it, move every HTTPS virtual host on this public address,
# including share.bonfire.icu and any existing blog, from public 443 to the
# loopback listener `127.0.0.1:8443 ssl`. Also enable coturn TLS on loopback
# 5349. The public 443 listener below then routes encrypted traffic by SNI
# without terminating TLS. A normal Cloudflare HTTP proxy cannot carry this
# TURN route.
map $ssl_preread_server_name $screener_tls_backend {
    turn.bonfire.icu screener_turn_tls;
    default screener_web_tls;
}

upstream screener_web_tls {
    server 127.0.0.1:8443;
}

upstream screener_turn_tls {
    server 127.0.0.1:5349;
}

server {
    listen 443;
    listen [::]:443;
    proxy_pass $screener_tls_backend;
    ssl_preread on;
    proxy_connect_timeout 5s;
    proxy_timeout 5h;
}
