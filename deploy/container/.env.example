# Public HTTPS origin served by your reverse proxy.
PIIK_CHANNEL_WEB_ORIGIN=https://share.example.com
# Supply separate, private, stable keys. Keep this file outside version control.
PIIK_CHANNEL_OWNER_KEY=
PIIK_CHANNEL_INVITE_KEY=
# Optional advertised invitation origin; defaults to the Web origin.
# PIIK_CHANNEL_INVITATION_ORIGIN=https://share.example.com
# Optional WebRTC ICE server JSON; defaults to the shared public STUN choices.
# PIIK_CHANNEL_ICE_SERVERS=[{"urls":["stun:stun.cloudflare.com:3478"]}]

# Rust Server media uses this direct UDP port; allow it through the host firewall.
PIIK_CHANNEL_UDP_PORT=8787
# Optional fixed public IP:port when NAT or a UDP tunnel changes the reachable address.
# PIIK_CHANNEL_UDP_PUBLIC_ADDRESS=203.0.113.10:8787

# To pin a release, replace latest with its vMAJOR.MINOR.PATCH tag.
# PIIK_IMAGE=ghcr.io/tntcrafthim/piik:latest
