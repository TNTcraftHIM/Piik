# Application
# Use 127.0.0.1 instead when only a same-host reverse proxy should connect.
LISTEN_HOST=0.0.0.0
PORT=8787
# For LAN viewers, replace localhost with this computer's LAN address.
PUBLIC_BASE_URL=http://localhost:8787
# Include both the host browser origin and PUBLIC_BASE_URL when they differ.
ALLOWED_ORIGINS=http://localhost:8787
# Production-required Host admission secret. Local development/tests may leave it
# empty. A non-empty value must contain 8-128 visible ASCII bytes (0x21-0x7e).
HOST_ADMISSION_PASSWORD=
# Optional SQLite file for persistent rooms. Requires HOST_ADMISSION_PASSWORD.
# The systemd example creates /var/lib/screener for this production path.
ROOM_DATABASE_PATH=
# Applies only to temporary rooms when ROOM_DATABASE_PATH is empty.
ROOM_TTL_SECONDS=14400
MAX_ROOMS=1000
MAX_VIEWERS_PER_ROOM=8
# Experimental standard-WebRTC relay chains. Keep false outside measured tests.
PEER_ASSISTED_MEDIA=false
# Required exact-room canary when peer assistance is true. Use a non-empty,
# comma-separated list of positive numeric room IDs; missing or blank fails startup.
PEER_ASSISTED_ROOM_IDS=

# Optional automatic SFU fallback capacity. Set PEER_ASSISTED_MEDIA=true and
# supply all three values together; leaving them empty keeps LiveKit completely
# dormant. Production requires wss and an independent API secret of 32+ bytes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Effective only when the complete LiveKit tuple is configured. Valid range: 1-2.
MAX_SFU_ROOTS_PER_ROOM=2

# Ordinary peer ICE discovery. Production requires at least one STUN URL.
# Separate multiple URLs with commas.
STUN_URLS=

# Optional exact-room Web peer ICE compatibility. All three values are required
# together and also require PEER_ASSISTED_MEDIA=true. The canary accepts one
# explicit UDP TURN URI; the shared secret must be independent and 32-128 bytes.
# Credential TTL is bounded to 300-1800 seconds. Leave absent/empty to disable.
PEER_ICE_TURN_URLS=
PEER_ICE_TURN_SHARED_SECRET=
PEER_ICE_TURN_CREDENTIAL_TTL_SECONDS=

# Minimal production example (use independent untracked secrets):
# HOST_ADMISSION_PASSWORD=replace-with-an-independent-access-key
# ROOM_DATABASE_PATH=/var/lib/screener/rooms.sqlite
# STUN_URLS=stun:stun.example.com:3478
# Automatic SFU fallback (requires PEER_ASSISTED_MEDIA=true and does not
# replace STUN above):
# PEER_ASSISTED_ROOM_IDS=1
# LIVEKIT_URL=wss://share.example.com
# LIVEKIT_API_KEY=replace-with-a-livekit-api-key
# LIVEKIT_API_SECRET=replace-with-at-least-32-independent-random-bytes
# MAX_SFU_ROOTS_PER_ROOM=2
# Optional built-in Peer ICE TURN canary for the same exact rooms:
# PEER_ICE_TURN_URLS=turn:turn.example.com:3478?transport=udp
# PEER_ICE_TURN_SHARED_SECRET=replace-with-32-to-128-independent-random-bytes
# PEER_ICE_TURN_CREDENTIAL_TTL_SECONDS=600
