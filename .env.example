# Application
# Use 127.0.0.1 instead when only a same-host reverse proxy should connect.
LISTEN_HOST=0.0.0.0
PORT=8787
# For LAN viewers, replace localhost with this computer's LAN address.
PUBLIC_BASE_URL=http://localhost:8787
# Include both the host browser origin and PUBLIC_BASE_URL when they differ.
ALLOWED_ORIGINS=http://localhost:8787
# Optional. Use 12-128 visible ASCII characters in production. When set, every
# browser must sign in before sharing or watching.
ACCESS_PASSWORD=
ROOM_TTL_SECONDS=14400
MAX_ROOMS=1000
MAX_VIEWERS_PER_ROOM=8

# ICE servers. Separate multiple URLs with commas.
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Minimal production example (use independent untracked secrets):
# ACCESS_PASSWORD=replace-with-a-strong-passphrase
# STUN_URLS=stun:turn.example.com:3478
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
# Optional TURN/TLS (standard port; append to TURN_URLS when configured):
# turns:turn.example.com:5349?transport=tcp
# Port 443 is an optional restrictive-network enhancement, not the default.
