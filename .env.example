# Application
# Keep the default loopback binding behind a local reverse proxy. Set
# LISTEN_HOST=0.0.0.0 explicitly only for a container or trusted LAN listener.
LISTEN_HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8787
ROOM_CREATION_TOKEN=
ROOM_TTL_SECONDS=14400
MAX_ROOMS=1000

# ICE servers. Separate multiple URLs with commas.
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Production example (use independent untracked secrets of at least 32 bytes):
# ROOM_CREATION_TOKEN=replace-with-at-least-32-random-bytes
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
