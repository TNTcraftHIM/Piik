{
  "name": "piik",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/package-licenses.mjs public/third-party-licenses.txt && vite",
    "build": "npm run build:web",
    "build:website": "node scripts/update-website-hero.mjs --check && node scripts/build-website.mjs",
    "preview:website": "vite preview --outDir build/site --host 127.0.0.1 --port 18890",
    "build:web": "node scripts/package-licenses.mjs public/third-party-licenses.txt && node --input-type=module -e \"import { readdirSync, rmSync } from 'node:fs'; const dir = 'internal/server/webassets/dist'; for (const entry of readdirSync(dir)) { if (entry !== '.gitkeep') rmSync(dir + '/' + entry, { recursive: true, force: true }); }\" && vite build",
    "package:app": "node scripts/assemble-app.mjs",
    "package:app-candidate": "node scripts/package-app-candidate.mjs",
    "check:go": "node scripts/check-go.mjs",
    "check:go-core": "node scripts/check-go.mjs --core",
    "check:go-race": "node scripts/check-go.mjs --race",
    "check:container": "node scripts/check-container.mjs",
    "check:native": "node scripts/check-go.mjs --capture-only",
    "gate:app-media": "tsx scripts/app-media-gate.ts",
    "gate:app-native-host": "tsx scripts/app-native-host-gate.ts",
    "gate:app-browser-fanout": "tsx scripts/app-browser-fanout-gate.ts",
    "gate:embedded-sfu": "tsx scripts/embedded-sfu-gate.ts",
    "gate:app-link": "tsx scripts/app-link-gate.ts",
    "gate:peer-topology-loopback": "tsx scripts/peer-assisted-benchmark.ts",
    "gate:sfu-admission": "vitest run tests/sfu-client.test.ts tests/route-transition.test.ts && go test ./internal/server/...",
    "gate:access-privacy": "npm run build:web && tsx scripts/access-privacy-gate.ts",
    "probe:app-loopback": "tsx scripts/app-loopback-gate.ts",
    "gate:app-local": "tsx scripts/app-local-gate.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sdp-transform": "3.0.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sdp-transform": "3.0.0",
    "semver": "7.8.5",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "ws": "8.21.3",
    "zod": "4.4.3"
  }
}
