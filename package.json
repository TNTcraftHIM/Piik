{
  "name": "piik",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node prototype/channel-browser/build.mjs && node scripts/package-licenses.mjs public/third-party-licenses.txt && vite",
    "build": "npm run build:web",
    "build:website": "node scripts/update-website-hero.mjs --check && tsx --tsconfig scripts/tsconfig.json scripts/update-guide-diagrams.tsx --check && node scripts/build-website.mjs",
    "update:guide-images": "node scripts/update-guide-images.mjs",
    "preview:website": "vite preview --outDir build/site --host 127.0.0.1 --port 18890",
    "build:web": "node scripts/build-channel-web.mjs",
    "package:app": "node scripts/assemble-app.mjs",
    "package:app-candidate": "node scripts/package-app-candidate.mjs",
    "check:rust": "node scripts/check-rust.mjs",
    "check:container": "node scripts/check-container.mjs",
    "typecheck": "node prototype/channel-browser/build.mjs && tsc -b --pretty false && tsc -p prototype/channel-browser/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:rust && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@oddbird/popover-polyfill": "0.7.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sdp-transform": "3.0.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sdp-transform": "3.0.0",
    "semver": "7.8.5",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "ws": "8.21.3",
    "zod": "4.6.6"
  }
}
