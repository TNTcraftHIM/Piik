{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.cache/tsconfig.tools.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Tests import the plain-ESM tooling modules under scripts/.
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "../vite.config.ts",
    "../vitest.config.ts",
    "../site/film/ui/main.tsx",
    "../site/film/ui/website.ts",
    "access-privacy-gate.ts",
    "browser-local-pool-probe.ts",
    "client-browser-fanout-gate.ts",
    "client-media-gate.ts",
    "client-native-host-gate.ts",
    "embedded-sfu-gate.ts",
    "embedded-sfu-page.ts",
    "client-loopback-gate.ts",
    "client-local-gate.ts",
    "client-link-gate.ts",
    "peer-assisted-benchmark.ts",
    "../tests"
  ]
}
