{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.cache/tsconfig.tools.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Tests import the plain-ESM tooling modules under scripts/.
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "../vite.config.ts",
    "../vitest.config.ts",
    "../site/film/ui/main.tsx",
    "update-guide-diagrams.tsx",
    "../src/client/ui/icons.tsx",
    "browser-local-pool-probe.ts",
    "network-lab.ts",
    "../tests"
  ]
}
