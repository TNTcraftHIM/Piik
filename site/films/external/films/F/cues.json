  "f_pulse": "broadcast pulse: soft sonar ping with a quick echo",
  "f_deal": "ten cards dealt: fast swish with ticks",
  "f_flip": "pitched card flip (note)",
  "f_dud": "the dud: deflating low womp + dull thud",
  "f_charge": "summon charge riser (until): rising noise + pitch, peaks at the end",
  "f_tier": "tier-up chime (note), brighter each time",
  "f_burst": "THE rainbow burst: huge impact, sub drop, glass shimmer cascade"
 }
